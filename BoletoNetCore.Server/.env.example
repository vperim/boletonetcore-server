# =============================================================================
# BoletoNetCore.Server - Configuração de Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# Variáveis de ambiente sobrescrevem os valores do appsettings.json.
# Use underscores duplos (__) para representar hierarquia JSON.
# =============================================================================

# -----------------------------------------------------------------------------
# ASP.NET Core
# -----------------------------------------------------------------------------

# Nome do ambiente: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# Porta HTTP do servidor (gRPC requer HTTP/2)
HTTP_PORTS=5000

# Hosts permitidos (use * para todos, ou lista separada por vírgula)
AllowedHosts=*

# -----------------------------------------------------------------------------
# Autenticação por API Key
# -----------------------------------------------------------------------------
# Autenticação simples por chave de API para deployments internos.
# A chave deve ser enviada no header X-API-Key.

# Habilitar autenticação por API key
ApiKey__Enabled=false

# Chave de API (obrigatório quando Enabled=true)
# Gere uma chave segura, ex: openssl rand -hex 32
# ApiKey__Key=sua-chave-secreta-aqui

# -----------------------------------------------------------------------------
# Proxy Reverso
# -----------------------------------------------------------------------------
# Habilite quando executar atrás de Nginx, HAProxy, Azure App Gateway, Cloudflare, etc.

# Habilitar processamento de headers de proxy reverso (X-Forwarded-For, X-Forwarded-Proto)
ReverseProxy__Enabled=false

# Habilitar tratamento específico de headers Cloudflare (CF-Connecting-IP)
ReverseProxy__UseCloudflare=false

# Número máximo de entradas de headers encaminhados a processar
ReverseProxy__ForwardLimit=1

# Endereços IP de proxies conhecidos (apenas headers destes IPs serão processados)
# Use notação indexada para arrays: __0, __1, __2, etc.
# ReverseProxy__KnownProxies__0=10.0.0.1
# ReverseProxy__KnownProxies__1=10.0.0.2

# Redes de proxies conhecidos em notação CIDR
# ReverseProxy__KnownNetworks__0=10.0.0.0/8
# ReverseProxy__KnownNetworks__1=172.16.0.0/12

# Nomes de host permitidos (vazio permite todos os hosts)
# ReverseProxy__AllowedHosts__0=exemplo.com.br

# -----------------------------------------------------------------------------
# gRPC-Web
# -----------------------------------------------------------------------------
# Habilite para clientes de navegador usando o protocolo gRPC-Web.
# Clientes gRPC padrão não são afetados quando habilitado.

# Habilitar suporte a gRPC-Web
GrpcWeb__Enabled=false

# Habilitar CORS para gRPC-Web (necessário quando clientes de navegador estão em origem diferente)
GrpcWeb__EnableCors=false

# Origens permitidas para CORS (vazio permite todas as origens)
# GrpcWeb__AllowedOrigins__0=https://exemplo.com.br
# GrpcWeb__AllowedOrigins__1=https://app.exemplo.com.br

# -----------------------------------------------------------------------------
# Logging (Serilog)
# -----------------------------------------------------------------------------

# Nível mínimo de log: Verbose, Debug, Information, Warning, Error, Fatal
Serilog__MinimumLevel__Default=Information

# Sobrescrever níveis de log para namespaces específicos
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__System.Net.Http.HttpClient=Warning
Serilog__MinimumLevel__Override__Grpc.AspNetCore.Server=Information

# Configuração de logging em arquivo
Serilog__WriteTo__1__Args__path=/app/logs/log.txt
Serilog__WriteTo__1__Args__rollingInterval=Day
Serilog__WriteTo__1__Args__fileSizeLimitBytes=10485760
Serilog__WriteTo__1__Args__retainedFileCountLimit=10
Serilog__WriteTo__1__Args__rollOnFileSizeLimit=true
