root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
indent_size = 4

# Add your C# code style rules here (naming conventions, braces, etc.)
# See: https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/code-style-rule-options

# XML-based files (csproj, props, targets, xml)
[*.{xml,csproj,props,targets,nuspec}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Razor files
[*.{razor,cshtml}]
indent_size = 4

# Markdown files (preserve trailing whitespace for hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Shell scripts (must be LF for Linux/macOS)
[*.sh]
end_of_line = lf

# Docker files (must be LF for Linux containers)
[Dockerfile]
end_of_line = lf

[.dockerignore]
end_of_line = lf

# Windows batch/PowerShell scripts (must be CRLF)
[*.{cmd,bat}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

# Solution files (Visual Studio requires CRLF)
[*.sln]
end_of_line = crlf
